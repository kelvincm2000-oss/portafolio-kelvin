---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
type Key = Parameters<typeof t>[0];

// bg = color de fondo de cada logo, para que la ficha del logo no muestre bordes
const clients = [
  { id: 'forge', name: 'Forge Works Welding', bg: '#e9e9ea' },
  { id: 'bmv', name: 'BMV Perfumes', bg: '#f9fffb' },
  { id: 'manada', name: 'Manada', bg: '#f8f5ed' },
  { id: 'natu', name: 'Natu', bg: '#000000' },
  { id: 'palmar', name: 'Paisaje el Palmar', bg: '#eef4df' },
];

const cases = clients.map((c) => ({
  ...c,
  sector: t(`clients.${c.id}.sector` as Key),
  reto: t(`clients.${c.id}.reto` as Key),
  solution: t(`clients.${c.id}.solution` as Key),
  deliverables: t(`clients.${c.id}.deliverables` as Key),
}));
---

<section id="clientes" class="clients relative py-28 md:py-36 bg-linear-30 from-pale-moss/70 via-white to-white text-forest-dark overflow-hidden">
  <!-- Fondo: cuadrícula de puntos como el Hero y manchas orgánicas como los fondos de las ilustraciones -->
  <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
    <div class="dots absolute inset-0"></div>
    <div class="blobs absolute inset-0">
      <span class="blob blob-1"></span>
      <span class="blob blob-2"></span>
      <span class="blob blob-3"></span>
      <span class="blob blob-4"></span>
    </div>
    <span class="spark spark-1">✦</span>
    <span class="spark spark-2">✦</span>
    <span class="spark spark-3">✦</span>
  </div>

  <div class="relative z-10 max-w-6xl mx-auto px-6">
    <!-- Encabezado -->
    <div class="text-center flex flex-col items-center">
      <h2 class="c-reveal text-6xl md:text-8xl font-black uppercase tracking-[-0.01em] leading-none text-forest-dark">
        {t('clients.title_main')} <span class="text-forest-green">{t('clients.title_sub')}</span>
      </h2>
      <p class="c-reveal mt-5 max-w-lg text-sm md:text-base font-bold text-forest-dark/60 normal-case">{t('clients.intro')}</p>
      <a
        href="/cv/Kelvin-Cadrazco-CV-Disenador-Grafico.pdf"
        target="_blank"
        rel="noopener"
        class="c-reveal mt-8 inline-flex items-center gap-3 px-8 py-4 bg-forest-dark text-white rounded-full text-[10px] font-black uppercase tracking-widest hover:bg-forest-green hover:scale-105 transition-all duration-500 shadow-lg shadow-forest-dark/20"
      >
        {t('clients.cv')} <span aria-hidden="true">↓</span>
      </a>
    </div>

    <!-- Carrusel -->
    <div class="relative mt-16">
      <div class="track no-scrollbar relative flex overflow-x-auto snap-x snap-mandatory scroll-smooth outline-none" tabindex="0" aria-roledescription="carousel" aria-label={t('clients.title_sub')}>
        {cases.map((c, i) => (
          <article class="slide w-full shrink-0 snap-center pl-1 pr-3 pt-2 pb-4" aria-roledescription="slide" aria-label={`${i + 1} / ${cases.length}: ${c.name}`} data-index={i}>
            <div class="card relative rounded-[2rem] bg-white border-2 border-forest-dark shadow-[8px_8px_0_0_#31572c] p-5 md:p-10 grid md:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] gap-8 md:gap-12 items-center overflow-hidden">
              <span class="absolute -top-6 right-4 md:right-8 text-[7rem] md:text-[10rem] font-black leading-none text-forest-dark/[0.05] select-none pointer-events-none" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>

              <figure class="work relative rounded-2xl overflow-hidden aspect-[4/5] max-h-[520px] w-full mx-auto shadow-[0_25px_50px_-20px_rgba(19,42,19,0.45)]">
                <img src={`/clients/work-${c.id}.jpg`} alt={`${c.name}: pieza de diseño`} loading="lazy" class="w-full h-full object-cover" />
              </figure>

              <div class="relative flex flex-col items-center text-center md:items-start md:text-left">
                <div data-anim class="logo-tile w-44 h-24 rounded-2xl flex items-center justify-center overflow-hidden ring-1 ring-forest-dark/10 shadow-md" style={`background:${c.bg}`}>
                  <img src={`/clients/${c.id}.png`} alt={`Logo ${c.name}`} loading="lazy" class="max-w-[86%] max-h-[78%] object-contain" />
                </div>
                <h3 data-anim class="mt-6 text-3xl md:text-4xl font-black uppercase tracking-[-0.01em] leading-none text-forest-dark">{c.name}</h3>
                <p data-anim class="mt-3 text-[10px] font-black uppercase tracking-[0.25em] text-olive">{c.sector}</p>

                <dl class="mt-8 space-y-5 text-sm leading-relaxed text-forest-dark/75 text-left w-full">
                  <div data-anim class="pl-4 border-l-2 border-moss">
                    <dt class="text-[10px] font-black uppercase tracking-[0.25em] text-forest-dark mb-1">{t('clients.reto')}</dt>
                    <dd>{c.reto}</dd>
                  </div>
                  <div data-anim class="pl-4 border-l-2 border-olive">
                    <dt class="text-[10px] font-black uppercase tracking-[0.25em] text-forest-dark mb-1">{t('clients.solution')}</dt>
                    <dd>{c.solution}</dd>
                  </div>
                  <div data-anim class="pl-4 border-l-2 border-forest-green">
                    <dt class="text-[10px] font-black uppercase tracking-[0.25em] text-forest-dark mb-1">{t('clients.deliverables')}</dt>
                    <dd>{c.deliverables}</dd>
                  </div>
                </dl>
              </div>
            </div>
          </article>
        ))}
      </div>

      <!-- Controles -->
      <div class="mt-8 flex items-center justify-center gap-6">
        <button type="button" class="c-prev w-12 h-12 rounded-full bg-white ring-1 ring-forest-dark/15 flex items-center justify-center hover:bg-forest-dark hover:text-white transition-all duration-300" aria-label={t('clients.prev')}>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m15 18-6-6 6-6"></path></svg>
        </button>
        <div class="flex items-center gap-2">
          {cases.map((c, i) => (
            <button type="button" class="dot h-2 rounded-full bg-forest-dark/20 transition-all duration-500" data-goto={i} aria-label={`${t('clients.go')}: ${c.name}`}></button>
          ))}
        </div>
        <span class="counter text-[11px] font-black tracking-widest text-forest-dark/50 w-14 text-center" aria-live="polite">01 / {String(cases.length).padStart(2, '0')}</span>
        <button type="button" class="c-next w-12 h-12 rounded-full bg-white ring-1 ring-forest-dark/15 flex items-center justify-center hover:bg-forest-dark hover:text-white transition-all duration-300" aria-label={t('clients.next')}>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"></path></svg>
        </button>
      </div>
      <div class="mt-6 mx-auto max-w-xs h-[2px] bg-forest-dark/10 rounded-full overflow-hidden">
        <div class="progress h-full w-0 bg-forest-green"></div>
      </div>
    </div>
  </div>
</section>

<style>
  .no-scrollbar { scrollbar-width: none; }
  .no-scrollbar::-webkit-scrollbar { display: none; }

  .dot { width: 0.5rem; }
  .dot[aria-current="true"] { width: 2rem; background: #31572c; }

  .dots {
    background-image: radial-gradient(rgba(49, 87, 44, 0.22) 1.2px, transparent 0);
    background-size: 28px 28px;
    mask-image: radial-gradient(ellipse at center, #000 30%, transparent 75%);
  }

  /* Formas tipo "blob" de las ilustraciones; solo se anima transform para no repintar */
  .blob {
    position: absolute; display: block; filter: blur(48px); opacity: 0.55; will-change: transform;
    animation: drift 22s ease-in-out infinite alternate paused;
  }
  .blob-1 { width: 34vw; height: 30vw; left: -8vw; top: 6%; background: #ecf39e; border-radius: 62% 38% 46% 54% / 55% 45% 55% 45%; }
  .blob-2 { width: 28vw; height: 32vw; right: -6vw; top: 18%; background: #90a955; opacity: 0.35; border-radius: 40% 60% 63% 37% / 42% 58% 42% 58%; animation-duration: 26s; animation-delay: -6s; }
  .blob-3 { width: 30vw; height: 24vw; left: 22%; bottom: -10vw; background: #ecf39e; border-radius: 55% 45% 38% 62% / 48% 62% 38% 52%; animation-duration: 30s; animation-delay: -12s; }
  .blob-4 { width: 18vw; height: 18vw; right: 18%; bottom: 8%; background: #4f772d; opacity: 0.18; border-radius: 48% 52% 60% 40% / 58% 40% 60% 42%; animation-duration: 18s; animation-delay: -3s; }
  @keyframes drift {
    0% { transform: translate(0, 0) rotate(0deg) scale(1); }
    50% { transform: translate(4vw, -3vw) rotate(25deg) scale(1.08); }
    100% { transform: translate(-3vw, 2vw) rotate(-15deg) scale(0.95); }
  }

  .spark { position: absolute; color: #4f772d; opacity: 0.35; will-change: transform; animation: twinkle 6s ease-in-out infinite paused; }
  .spark-1 { left: 8%; top: 14%; font-size: 2.2rem; }
  .spark-2 { right: 10%; top: 9%; font-size: 1.4rem; animation-delay: -2s; }
  .spark-3 { right: 6%; bottom: 14%; font-size: 2.8rem; animation-delay: -4s; }
  @keyframes twinkle {
    0%, 100% { transform: scale(0.8) rotate(0deg); opacity: 0.2; }
    50% { transform: scale(1.15) rotate(90deg); opacity: 0.5; }
  }

  .clients.is-live .blob, .clients.is-live .spark { animation-play-state: running; }

  @media (prefers-reduced-motion: reduce) {
    .blob, .spark { animation: none; }
  }
</style>

<script>
  import { gsap } from "../lib/gsap";

  const section = document.getElementById("clientes");
  const track = section?.querySelector<HTMLElement>(".track");
  const slides = Array.from(section?.querySelectorAll<HTMLElement>(".slide") ?? []);
  const dots = Array.from(section?.querySelectorAll<HTMLButtonElement>(".dot") ?? []);
  const counter = section?.querySelector<HTMLElement>(".counter");
  const progress = section?.querySelector<HTMLElement>(".progress");
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const AUTOPLAY_MS = 7000;

  if (section && track && slides.length) {
    let current = -1;
    let paused = false;
    let inView = false;
    let progressTween: gsap.core.Tween | null = null;

    const pad = (n: number) => String(n).padStart(2, "0");

    const animated = new Set<number>();
    let target: number | null = null;
    let lockTimer: number | undefined;

    const animateSlide = (i: number) => {
      if (reduced || animated.has(i)) return;
      animated.add(i);
      const slide = slides[i];
      const work = slide.querySelector(".work");
      const img = slide.querySelector(".work img");
      const items = slide.querySelectorAll("[data-anim]");
      const tl = gsap.timeline({ defaults: { ease: "power3.out" } });
      tl.fromTo(work, { clipPath: "inset(100% 0% 0% 0%)" }, { clipPath: "inset(0% 0% 0% 0%)", duration: 1 })
        .fromTo(img, { scale: 1.25 }, { scale: 1, duration: 1.4 }, 0)
        .fromTo(items[0], { scale: 0.6, rotate: -8, opacity: 0 }, { scale: 1, rotate: 0, opacity: 1, duration: 0.8, ease: "back.out(1.8)" }, 0.15)
        .fromTo(Array.from(items).slice(1), { y: 28, opacity: 0 }, { y: 0, opacity: 1, duration: 0.7, stagger: 0.09 }, 0.3);
    };

    const runProgress = () => {
      progressTween?.kill();
      if (!progress) return;
      gsap.set(progress, { width: "0%" });
      if (reduced || paused || !inView) return;
      progressTween = gsap.to(progress, {
        width: "100%",
        duration: AUTOPLAY_MS / 1000,
        ease: "none",
        onComplete: () => goTo((current + 1) % slides.length),
      });
    };

    const setActive = (i: number) => {
      if (i === current) return;
      current = i;
      dots.forEach((d, j) => d.setAttribute("aria-current", String(j === i)));
      if (counter) counter.textContent = `${pad(i + 1)} / ${pad(slides.length)}`;
      animateSlide(i);
      runProgress();
    };

    // Saltos de más de un caso (incluida la vuelta del último al primero) usan un fundido en vez de rebobinar
    let fading = false;

    const lockUntilArrival = (i: number) => {
      target = i;
      window.clearTimeout(lockTimer);
      lockTimer = window.setTimeout(() => (target = null), 1500);
    };

    const goTo = (i: number) => {
      if (i === current) return;
      const jump = Math.abs(i - current) > 1;
      setActive(i);
      lockUntilArrival(i);
      if (fading) return; // el fundido en curso terminará en el caso más reciente (current)
      if (jump && !reduced) {
        fading = true;
        gsap.killTweensOf(track);
        gsap.to(track, {
          opacity: 0,
          duration: 0.25,
          ease: "power1.in",
          onComplete: () => {
            lockUntilArrival(current);
            track.scrollTo({ left: slides[current].offsetLeft, behavior: "instant" });
            fading = false;
            gsap.to(track, { opacity: 1, duration: 0.4, ease: "power1.out" });
          },
        });
      } else {
        track.scrollTo({ left: slides[i].offsetLeft, behavior: reduced ? "instant" : "smooth" });
      }
    };

    const slideObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (!e.isIntersecting) return;
          const idx = Number((e.target as HTMLElement).dataset.index);
          if (target !== null) {
            if (idx !== target) return;
            target = null;
          }
          setActive(idx);
        });
      },
      { root: track, threshold: 0.6 },
    );
    slides.forEach((s) => slideObserver.observe(s));

    new IntersectionObserver(
      ([e]) => {
        inView = e.isIntersecting;
        section.classList.toggle("is-live", inView);
        runProgress();
      },
      { threshold: 0.25 },
    ).observe(section);

    section.querySelector(".c-prev")?.addEventListener("click", () => goTo((current - 1 + slides.length) % slides.length));
    section.querySelector(".c-next")?.addEventListener("click", () => goTo((current + 1) % slides.length));
    section.querySelectorAll<HTMLElement>("[data-goto]").forEach((el) =>
      el.addEventListener("click", () => goTo(Number(el.dataset.goto))),
    );

    track.addEventListener("keydown", (e) => {
      if (e.key === "ArrowRight") { e.preventDefault(); goTo((current + 1) % slides.length); }
      if (e.key === "ArrowLeft") { e.preventDefault(); goTo((current - 1 + slides.length) % slides.length); }
    });

    const pause = () => { paused = true; runProgress(); };
    const resume = () => { paused = false; runProgress(); };
    track.addEventListener("pointerenter", pause);
    track.addEventListener("pointerleave", resume);
    track.addEventListener("focusin", pause);
    track.addEventListener("focusout", resume);

    // IntersectionObserver en vez de ScrollTrigger: el libro de PDFs cambia la altura de la página al cargar
    if (!reduced) {
      const reveals = section.querySelectorAll(".c-reveal");
      gsap.set(reveals, { y: 40, opacity: 0 });
      const introObserver = new IntersectionObserver(
        ([e]) => {
          if (!e.isIntersecting) return;
          introObserver.disconnect();
          gsap.to(reveals, { y: 0, opacity: 1, duration: 1, stagger: 0.12, ease: "power3.out" });        },
        { threshold: 0.1 },
      );
      introObserver.observe(section);
    }
  }
</script>
